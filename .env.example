DATABASE_URL="postgresql://user:password@localhost:5432/votocerto?sslmode=disable"

# TSE — ver docs/tse-integration.md antes de preencher em produção
TSE_CANDIDATES_DATASET_URL="https://dadosabertos.tse.jus.br/dataset/candidatos-2026"
TSE_CANDIDATES_COMPLEMENTARY_URL="https://divulgacandcontas.tse.jus.br/divulga/"
TSE_RESULTS_INFO_URL="https://www.tse.jus.br/eleicoes/informacoes-tecnicas-sobre-a-divulgacao-de-resultados"
TSE_RESULTS_FILES_URL="https://www.tse.jus.br/eleicoes/eleicoes-2026-content/arquivos/divulgacao-de-resultados"
TSE_RESULTS_PORTAL_URL="https://resultados.tse.jus.br/oficial/"
# TSE_RESULTS_DOWNLOAD_BASE_URL= # preencher somente após confirmar docs/tse-integration.md

# mock | tse-simulation | production
RESULTS_MODE="mock"

ADMIN_PASSWORD="troque-esta-senha"
ADMIN_SESSION_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

ENABLE_QUIZ="true"
ENABLE_COMPARISON="true"
ENABLE_BALLOT="true"
ENABLE_LIVE_RESULTS="true"
ENABLE_GOVERNMENT_PLAN_AI="false"
ENABLE_SECOND_ROUND="false"
ENABLE_RESULT_MAP="true"
